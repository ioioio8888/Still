{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/handler.js": { "maxDuration": 30, "includeFiles": "moderation-policy.json" }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/handler?route=:path*" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "no-referrer" },
      { "key": "Content-Security-Policy", "value": "default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self' data:; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" }
    ] },
    { "source": "/api/:path*", "headers": [
      { "key": "Cache-Control", "value": "private, no-store" }
    ] }
  ]
}
